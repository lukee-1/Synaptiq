APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SUPABASE_URL=https://wpjxohdwrwcjeunspjce.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Worker only; never use a NEXT_PUBLIC prefix.
SUPABASE_SECRET_KEY=
MODEL_BASE_URL=http://127.0.0.1:8001/v1
# Set unsloth when connecting to Unsloth Studio (usually port 8888).
MODEL_RUNTIME=openai
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=90
EXECUTOR_URL=
EXECUTOR_TOKEN=
WORKER_POLL_SECONDS=2
# Hosted API only: external enables jobs handled by a separately configured worker.
# Leave local on the laptop; no model/executor credentials belong in the hosted API.
WORKER_MODE=local

# Local capability-isolated executor; use gvisor for a provisioned Linux runner.
EXECUTOR_BACKEND=wasi
# Keep the scoped queue token in backend/.runtime/worker.env (worker only).
# WORKER_TOKEN=...
